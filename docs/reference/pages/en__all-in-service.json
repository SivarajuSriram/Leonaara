    "content": {
     "header": "Inklusivleistungen",
     "subheader": "",
     "headerLayout": 0,
     "headerPosition": "",
     "headerLink": "",
     "type": "mask_list",
     "title": "Included services",
     "text": "",
     "listitems": [
      {
       "uid": "25",
       "title": "General",
       "text": "<ul><li><span>overnight stay with a view&nbsp;</span></li><li><span>premium suite amenities including Dyson hairdryer, record player, speaker, curated book selection&nbsp;</span></li><li><span>organic body care by March - made in austria</span></li><li><span>covered parking lot at the Ehrwalder Almbahn cable car valley station</span></li><li><span>private shuttle from the covered parking lot at the Ehrwalder Almbahn valley station to eriro (during cable car maintenance periods)&nbsp;</span></li><li><span>daily suite service</span></li><li><span>firewood in the </span><i><span>felisa </span></i><span>&amp; </span><i><span>himil </span></i><span>suites</span></li><li><span>free in-suite WiFi</span></li><li><span>complete tranquillity. Clear mountain air. Close to the sky</span></li></ul>"
      },
      {
       "uid": "26",
       "title": "Experiences",
       "text": "<ul><li><span>personalised assistance from our hosts and adventure guides&nbsp;</span></li><li><span>privately guided nature, culture and creative experiences&nbsp;</span></li><li><span>free use of the eriro creative workshop&nbsp;</span></li><li><span>Swarovski Optik binoculars for wildlife watching</span></li><li><span>mountain essentials including hiking poles, hiking backpack, water bottle, first aid kit&nbsp;&nbsp;</span></li><li><span>premium brand mountain bikes and other equipment (summertime)&nbsp;</span></li><li><span>organisation of outdoor winter gear rental (equipment fees will be applied)&nbsp;</span></li><li><span>snowshoes and avalanche transceiver (wintertime)&nbsp;</span></li><li>ski pass included – straight from eriro to the slopes</li><li><span>ski-in and ski-out: the first on the slopes in the morning. Untouched snow and silent mountains</span></li><li><span>use of all cable cars and lifts in the Ehrwalder Alm ski and hiking area (during operating hours)&nbsp;</span></li></ul>"
      },
      {
       "uid": "18",
       "title": "Gastronomy",
       "text": "<ul><li><span>breakfast, lunch and dinner at the </span><i><span>ezzan</span></i><span> restaurant&nbsp;</span></li><li><span>selection of snacks laid out on the long table in the central </span><i><span>herza</span></i><span> (Old High German for ‘heart’) room of the hotel</span></li><li><span>curated selection of drinks (excl. certain premium spirits)&nbsp;</span></li><li><span>in-suite coffee, tea and drinks bar&nbsp;</span></li></ul>"
      },
      {
       "uid": "20",
       "title": "Spa",
       "text": "<ul><li>Use of the SPA <i>roa </i>with saunas, new infinity alpine meadow pool and various other water pools</li><li>hay lounge with infrared and sound loungers</li><li>heated towel cabinet</li><li>(tea) herb bar with wellness snacks</li></ul>"
      }
     ]
    }
   },
